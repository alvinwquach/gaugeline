{
  "name": "gaugeline-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky",
    "schema:build": "tsx scripts/build-schema.ts",
    "schema:check": "tsx scripts/build-schema.ts --check",
    "docs:flags": "tsx scripts/build-docs.ts",
    "docs:flags:check": "tsx scripts/build-docs.ts --check",
    "smoke": "tsx scripts/smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "18.19.130",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "fast-check": "4.10.2",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "prettier": "3.9.10",
    "tsup": "8.5.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "6.4.5",
    "vitest": "3.2.7",
    "zod": "4.6.7"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.5"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  }
}
