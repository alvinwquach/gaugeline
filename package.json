{
  "name": "gaugeline-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build && node scripts/embed-client.mjs",
    "embed:client": "node scripts/embed-client.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky",
    "schema:build": "tsx scripts/build-schema.ts",
    "schema:check": "tsx scripts/build-schema.ts --check",
    "docs:flags": "tsx scripts/build-docs.ts",
    "docs:flags:check": "tsx scripts/build-docs.ts --check",
    "smoke": "tsx scripts/smoke.ts",
    "changeset": "changeset",
    "version": "changeset version && pnpm docs:changelog",
    "release": "pnpm build && changeset publish",
    "docs:changelog": "tsx scripts/changelog-to-docs.ts",
    "pr-gate": "tsx scripts/pr-gate.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1 --port 4173",
    "docs:check": "tsx scripts/check-docs.ts",
    "docs:e2e": "playwright test",
    "gen:checks": "tsx scripts/gen-checks.ts",
    "new:check": "tsx scripts/new-check.ts",
    "docs:examples": "tsx scripts/docs-examples.ts",
    "dogfood": "tsx scripts/dogfood.ts",
    "surface": "tsx scripts/check-surface.ts",
    "adr:check": "tsx scripts/check-adr.ts",
    "community:check": "tsx scripts/check-community.ts",
    "pr:check": "tsx scripts/reporting/check-pr-body.ts"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "fast-check": "4.10.2",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "prettier": "3.9.10",
    "tsup": "8.5.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.7",
    "vitepress": "1.6.4",
    "vitest": "5.1.0",
    "vue": "3.5.13",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  }
}
