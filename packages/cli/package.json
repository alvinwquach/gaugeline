{
  "name": "gaugeline",
  "version": "0.1.0",
  "description": "Check a website the way search engines and visitors see it. Read-only.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "gaugeline": "./dist/index.js"
  },
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvinwquach/gaugeline.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "seo",
    "website",
    "check",
    "canonical",
    "ci",
    "read-only"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0 <7"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@gaugeline/app": "workspace:*",
    "@gaugeline/app-server": "workspace:*",
    "@gaugeline/core": "workspace:*"
  },
  "private": false
}
