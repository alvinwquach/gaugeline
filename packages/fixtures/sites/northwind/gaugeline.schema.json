{
  "organizationId": "/#organization",
  "websiteId": "/#website",
  "templates": [
    {
      "match": "/blog/*",
      "require": [
        "Article",
        "WebPage",
        "BreadcrumbList"
      ]
    },
    {
      "match": "/**",
      "require": [
        "WebPage"
      ]
    }
  ],
  "breadcrumbs": {
    "firstName": "Home",
    "firstUrl": "/"
  }
}
