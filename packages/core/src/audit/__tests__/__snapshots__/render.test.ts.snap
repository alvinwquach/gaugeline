.f p{margin:.25rem 0}.tech,.id{color:#475467;font-size:.875rem}.tech code{white-space:pre-wrap;word-break:break-word}
ul.ok li{margin:.15rem 0}code{font-family:ui-monospace,Menlo,Consolas,monospace}.brand img{max-height:3rem;max-width:12rem;margin:0 0 .5rem}p.quiet{color:#475467;margin:.25rem 0}li{margin:.4rem 0}ul ul{margin:.2rem 0;color:#475467;font-size:.9rem}</style>
</head>
