{
  "about": "Shared test cases for the read-only SQL classifier. Gaugeline's classifier (packages/core/src/connectors/postgres/classify.ts) and LocalQuery's copy must agree on every verdict. expect is \"allow\" (one read) or \"refuse\" (anything else). family says why, for people; only the verdict is the contract. Add a case here whenever either copy finds a gap, then fix both.",
  "version": 1,
  "cases": [
    {
      "id": "select-basic",
      "sql": "select name from menu_items where is_86 = true",
      "expect": "allow",
      "family": "read"
    },
    {
      "id": "select-upper-case",
      "sql": "SELECT COUNT(*) FROM Bookings WHERE party_size >= 8",
      "expect": "allow",
      "family": "read"
    },
