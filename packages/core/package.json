{
  "name": "@gaugeline/core",
  "version": "0.0.0",
  "description": "The Gaugeline check engine. No CLI code, no process exits.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/*": "./schema/*"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "fflate": "0.8.2",
    "groq-js": "2.0.1",
    "htmlparser2": "9.1.0",
    "jsqr": "1.4.0",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "postgres": "3.4.9"
  }
}
