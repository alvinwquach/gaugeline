{
  "name": "@gaugeline/core",
  "version": "0.0.0",
  "description": "The Gaugeline check engine. No CLI code, no process exits.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  }
}
